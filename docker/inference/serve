#!/usr/bin/env python3
"""BYOC serving entrypoint. SageMaker runs the image as `docker run <img> serve`.

Launches gunicorn against the Flask app in serve.py, binding the 8080 port
SageMaker routes /ping and /invocations to.
"""

import subprocess
import sys

WORKERS = "1"  # one worker: the model holds GPU memory; scale out via instances.
TIMEOUT = "120"


def main() -> int:
    cmd = [
        "gunicorn",
        "--bind",
        "0.0.0.0:8080",
        "--workers",
        WORKERS,
        "--timeout",
        TIMEOUT,
        "--chdir",
        "/opt/ml/code",
        "serve:app",
    ]
    return subprocess.call(cmd)


if __name__ == "__main__":
    # SageMaker passes the literal arg "serve"; ignore any extra args.
    sys.exit(main())
